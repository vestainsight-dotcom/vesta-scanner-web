{
  "name": "vesta-scanner-web",
  "version": "0.1.0",
  "private": true,
  "description": "VESTA Scanner public frontend — demo mode with simulated market data only.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/*.test.ts",
    "scan:security": "node scripts/security-scan.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run scan:security && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
