# dependencies
/node_modules

# next.js build output and generated files
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# test and coverage output
/coverage/
/test-results/
/playwright-report/
*.lcov

# env files: this project needs none; never commit any
.env
.env.*

# local security rules (optional, maintainer-only; see scripts/security-scan.mjs)
/security.local.json

# local credentials and keys
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc
.netrc

# files generated by local AI coding agents (e.g. `next dev` writes these when it detects one)
/AGENTS.md
/CLAUDE.md
/CLAUDE.local.md
.claude/
.cursor/

# editors, OS and logs
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# local audit artifacts, browser profiles and scratch screenshots
# (published screenshots live in docs/images/ and are not ignored)
/.audit/
/.scratch/
/chrome-profile*/
/tmp/

# deployment configs are out of scope until a reviewed phase adds them
.vercel
.netlify
